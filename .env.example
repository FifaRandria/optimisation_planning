# ---------------------------------------------------------------------------
# Docker (recommandé) : « make init » copie ce fichier en .env et génère POSTGRES_PASSWORD.
# Ne versionnez jamais .env : il contient les secrets.
# ---------------------------------------------------------------------------

# Mot de passe de l'utilisateur PostgreSQL dédié « transport_app » (généré par make init).
POSTGRES_PASSWORD=A_GENERER

# Port de l'application sur le poste / le serveur : http://localhost:3000
APP_PORT=3000

# Administrateur initial, créé au premier démarrage s'il n'existe aucun admin.
# Il devra changer ce mot de passe à sa première connexion.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026!

# Durée d'une session, en heures.
SESSION_TTL_HOURS=12

# true derrière HTTPS (serveur de production) ; false en local (http://localhost).
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Développement sans conteneur pour l'application (« make dev-db » puis « make dev ») :
# l'URL est construite automatiquement par le Makefile à partir de POSTGRES_PASSWORD.
# Sans Docker du tout : renseignez DATABASE_URL vers votre PostgreSQL, puis « npm run db:init ».
# DATABASE_URL=postgres://transport_app:MOT_DE_PASSE@localhost:5433/transport_optimizer
# ---------------------------------------------------------------------------
